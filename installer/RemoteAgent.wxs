<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?define ProductVersion="1.0.0.0" ?>
  <?define ProductUpgradeCode="12345678-1234-1234-1234-123456789012" ?>

  <Product 
    Id="*" 
    Name="Remote Agent" 
    Language="1033" 
    Version="$(var.ProductVersion)" 
    Manufacturer="Remote Agent Corp" 
    UpgradeCode="$(var.ProductUpgradeCode)">

    <Package 
      InstallerVersion="200" 
      Compressed="yes" 
      InstallScope="perMachine" 
      Description="Remote Agent Installer"
      Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Remote Agent is already installed." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="RemoteAgent" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Remote Agent" />
      </Directory>
    </Directory>

    <Media Id="1" Cabinet="RemoteAgent.cab" EmbedCab="yes" />

    <!-- Feature definition -->
    <Feature Id="ProductFeature" Title="Remote Agent" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="ConfigComponent" />
      <ComponentRef Id="LogsComponent" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>

    <!-- Main application files -->
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Single native Go executable - handles agent, service install, and service uninstall via flags -->
      <Component Id="MainExecutable" Guid="11111111-1111-1111-1111-111111111111">
        <File Id="RemoteAgentExe" Source="$(var.SourceDir)\bin\RemoteAgent.exe" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\RemoteAgent" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="no" />
      </Component>

      <!-- Configuration directory (created by RemoteAgent.exe during install service) -->
      <Directory Id="CONFIGFOLDER" Name="config">
        <Component Id="ConfigComponent" Guid="22222222-2222-2222-2222-222222222222" KeyPath="yes">
          <CreateFolder />
        </Component>
      </Directory>

      <!-- Logs directory -->
      <Directory Id="LOGSFOLDER" Name="logs">
        <Component Id="LogsComponent" Guid="55555555-5555-5555-5555-555555555555" KeyPath="yes">
          <CreateFolder />
        </Component>
      </Directory>
    </DirectoryRef>

    <!-- Start menu shortcuts -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcuts" Guid="44444444-4444-4444-4444-444444444444">
        <Shortcut Id="UninstallShortcut" Name="Uninstall Remote Agent" Target="[System64Folder]msiexec.exe" 
          Arguments="/x [ProductCode]" Description="Removes Remote Agent from your computer" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Remote Agent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Custom Actions -->
    <!-- Run RemoteAgent.exe with install-service flag after files are installed -->
    <CustomAction
      Id="RunInstallService"
      FileKey="RemoteAgentExe"
      ExeCommand="--install-service"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <!-- Run RemoteAgent.exe with uninstall-service flag before files are removed -->
    <CustomAction
      Id="RunUninstallService"
      FileKey="RemoteAgentExe"
      ExeCommand="--uninstall-service"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Scheduling: install runs after InstallFiles, uninstall before RemoveFiles -->
    <InstallExecuteSequence>
      <Custom Action="RunInstallService" After="InstallFiles">NOT Installed</Custom>
      <Custom Action="RunUninstallService" Before="RemoveFiles">Installed AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <!-- User Interface -->
    <UIRef Id="WixUI_InstallDir" />
    <WixVariable Id="WixUIInstallDirectory" Value="INSTALLFOLDER" />

  </Product>
</Wix>
